# Required for local stdio and private HTTP compatibility mode.
GETMNEMO_API_URL=https://api.mnemohq.com
GETMNEMO_API_KEY=
GETMNEMO_WORKSPACE_ID=

# Tenant boundary for local stdio/private HTTP only.
# Supplied by the developer/operator at startup; the model can NEVER set it.
# Use the simple tag form...
GETMNEMO_CONTAINER_TAG=user:jane
# ...OR the structured-scope form (both type and id required if used):
# GETMNEMO_SCOPE_TYPE=user
# GETMNEMO_SCOPE_ID=jane

# HTTP transport only
PORT=8787

# HTTP only. Keep disabled unless a trusted gateway binds the requested
# container to the authenticated credential.
GETMNEMO_ALLOW_HEADER_SCOPE=0

# HTTP only. OAuth identifiers advertised in /.well-known/oauth-protected-resource
# and the 401 resource_metadata. Defaults: https://mcp.mnemohq.com/mcp and
# https://api.mnemohq.com/v1/mcp/oauth.
# MCP_RESOURCE_URL=
# MCP_AUTHORIZATION_SERVER=
# Optional, comma-separated: old resource URLs still served after a host move.
# A request to one of their hosts is told that resource instead of the primary.
# MCP_LEGACY_RESOURCE_URLS=

# Optional. How long the API's answer model may take, in ms (procedure_ask and
# the answer tool wait this plus 5 s, at most 295 s). Leave unset on hosted.
# A self-hosted install on its bundled local model sets it to the API's
# PROCEDURE_ASK_TIMEOUT_MS (290000): a CPU model answers in minutes.
# GETMNEMO_MODEL_TIMEOUT_MS=
